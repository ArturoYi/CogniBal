<?xml version="1.0" encoding="utf-8"?>
<!--
  系统微件选择器靠这份元数据发现卡片。
  initialLayout 用 Glance 自带的加载布局；previewLayout 给 Android 12 及以上，
  previewImage 给更早的系统。两套预览都要有，选择器才列得出来。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/ledger_widget_preview"
    android:previewImage="@drawable/ledger_widget_preview_image"
    android:minWidth="@dimen/ledger_widget_min_width"
    android:minHeight="@dimen/ledger_widget_min_height"
    android:minResizeWidth="@dimen/ledger_widget_min_resize_width"
    android:minResizeHeight="@dimen/ledger_widget_min_resize_height"
    android:maxResizeWidth="@dimen/ledger_widget_max_resize_width"
    android:maxResizeHeight="@dimen/ledger_widget_max_resize_height"
    android:targetCellWidth="@integer/ledger_widget_target_cell_width"
    android:targetCellHeight="@integer/ledger_widget_target_cell_height"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
